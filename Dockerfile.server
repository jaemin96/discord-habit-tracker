# ── Stage 1: prune ──────────────────────────────────────────────────────────
FROM node:24-alpine AS pruner
WORKDIR /app

RUN npm install -g turbo
COPY . .
RUN turbo prune @habit-tracker/server --docker

# ── Stage 2: install ─────────────────────────────────────────────────────────
FROM node:24-alpine AS installer
WORKDIR /app

RUN npm install -g pnpm

# lockfile + 패키지 메타만 먼저 복사 (레이어 캐시 활용)
COPY --from=pruner /app/out/json/ .
COPY --from=pruner /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
RUN pnpm install --frozen-lockfile

# 소스 복사 후 빌드
COPY --from=pruner /app/out/full/ .
RUN pnpm turbo run build --filter=@habit-tracker/server

# ── Stage 3: runner ──────────────────────────────────────────────────────────
FROM node:24-alpine AS runner
WORKDIR /app

RUN npm install -g pnpm

COPY --from=installer /app/apps/habit-tracker-server/package.json ./package.json
COPY --from=installer /app/apps/habit-tracker-server/dist ./dist
COPY --from=installer /app/apps/habit-tracker-server/node_modules ./node_modules
COPY --from=installer /app/node_modules/.prisma ./node_modules/.prisma

EXPOSE 4003

CMD ["node", "dist/main"]
